{
  "manifestVersion": 2,
  "id": "shortcut",
  "name": "Shortcut",
  "version": "0.1.0",
  "description": "Shortcut stories and sub-tasks in Orca: browse your work, start worktrees from sub-tasks and keep Shortcut in step.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "shortcut",
        "title": "Shortcut",
        "icon": "layers",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "secrets:own"
    }
  ]
}
